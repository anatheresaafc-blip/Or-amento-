<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Espaço Sentir - Orçamento</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <style>
        /* ===== RESET & BASE ===== */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        :root {
            --primary: #7BA8C4;
            --primary-dark: #5a8aaa;
            --primary-light: #b5d4e8;
            --secondary: #D4A5A5;
            --secondary-light: #eccccc;
            --bg: #f5f7fa;
            --card: #ffffff;
            --text: #2d3748;
            --text-light: #718096;
            --border: #e2e8f0;
            --success: #48bb78;
            --shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            --radius: 16px;
            --radius-sm: 10px;
            --transition: 0.3s ease;
        }
        html {
            scroll-behavior: smooth;
        }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
        }
        a {
            color: var(--primary);
            text-decoration: none;
        }

        /* ===== LOGIN OVERLAY ===== */
        #loginOverlay {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 20px;
            transition: opacity 0.5s ease;
        }
        #loginOverlay.hidden {
            opacity: 0;
            pointer-events: none;
        }
        .login-box {
            background: var(--card);
            border-radius: var(--radius);
            padding: 48px 40px 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.2);
            text-align: center;
            animation: fadeUp 0.6s ease;
        }
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .login-box .logo-login {
            width: 90px;
            height: 90px;
            background: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 36px;
            font-weight: 700;
            color: #fff;
            box-shadow: 0 8px 24px rgba(123, 168, 196, 0.3);
        }
        .login-box h2 {
            font-size: 24px;
            color: var(--text);
            margin-bottom: 4px;
        }
        .login-box p.sub {
            color: var(--text-light);
            font-size: 14px;
            margin-bottom: 28px;
        }
        .login-box label {
            display: block;
            text-align: left;
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 6px;
        }
        .login-box .input-group {
            position: relative;
            margin-bottom: 20px;
        }
        .login-box .input-group input {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 16px;
            transition: var(--transition);
            background: var(--bg);
        }
        .login-box .input-group input:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 4px rgba(123, 168, 196, 0.15);
            background: #fff;
        }
        .login-box .btn-primary {
            width: 100%;
            padding: 14px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: var(--radius-sm);
            font-size: 17px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }
        .login-box .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }
        .login-error {
            color: #e53e3e;
            font-size: 14px;
            margin-top: 12px;
            min-height: 24px;
        }

        /* ===== APP CONTAINER ===== */
        #appContainer {
            display: none;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px 24px 60px;
        }
        #appContainer.active {
            display: block;
            animation: fadeUp 0.5s ease;
        }

        /* ===== HEADER ===== */
        .header {
            background: var(--card);
            border-radius: var(--radius);
            padding: 24px 32px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 24px;
            flex-wrap: wrap;
            margin-bottom: 28px;
        }
        .header-logo {
            flex-shrink: 0;
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            color: #fff;
            box-shadow: 0 6px 18px rgba(123, 168, 196, 0.3);
        }
        .header-info {
            flex: 1;
            min-width: 200px;
        }
        .header-info h1 {
            font-size: 26px;
            font-weight: 700;
            color: var(--text);
            letter-spacing: -0.5px;
        }
        .header-info .tagline {
            font-size: 14px;
            color: var(--text-light);
            margin-top: 2px;
        }
        .header-contact {
            display: flex;
            flex-wrap: wrap;
            gap: 12px 24px;
            font-size: 14px;
            color: var(--text-light);
            margin-top: 6px;
        }
        .header-contact span {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .header-contact i {
            font-style: normal;
            font-weight: 600;
            color: var(--primary);
        }
        .header-badge {
            background: var(--secondary-light);
            color: #8b5e5e;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        /* ===== PROGRESS BAR ===== */
        .progress-container {
            background: var(--card);
            border-radius: var(--radius);
            padding: 20px 32px;
            box-shadow: var(--shadow);
            margin-bottom: 28px;
        }
        .progress-steps {
            display: flex;
            justify-content: space-between;
            position: relative;
            max-width: 800px;
            margin: 0 auto;
        }
        .progress-steps::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--border);
            transform: translateY(-50%);
            z-index: 0;
        }
        .progress-steps .step {
            position: relative;
            z-index: 1;
            background: var(--card);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            padding: 0 8px;
            transition: var(--transition);
        }
        .progress-steps .step .circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            color: var(--text-light);
            transition: var(--transition);
            border: 3px solid transparent;
        }
        .progress-steps .step.active .circle {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary-light);
            box-shadow: 0 4px 12px rgba(123, 168, 196, 0.3);
        }
        .progress-steps .step.done .circle {
            background: var(--success);
            color: #fff;
        }
        .progress-steps .step .label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-light);
            text-align: center;
            transition: var(--transition);
            max-width: 80px;
        }
        .progress-steps .step.active .label {
            color: var(--primary);
        }
        .progress-steps .step.done .label {
            color: var(--success);
        }

        /* ===== SECTIONS ===== */
        .section-card {
            background: var(--card);
            border-radius: var(--radius);
            padding: 32px 36px;
            box-shadow: var(--shadow);
            margin-bottom: 28px;
            display: none;
            animation: fadeUp 0.4s ease;
        }
        .section-card.active {
            display: block;
        }
        .section-card h3 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-card h3 .num {
            background: var(--primary);
            color: #fff;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }
        .section-card .desc {
            color: var(--text-light);
            font-size: 14px;
            margin-bottom: 24px;
            margin-left: 42px;
        }

        /* ===== FORM ELEMENTS ===== */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px 28px;
        }
        .form-grid.full {
            grid-template-columns: 1fr;
        }
        .form-group {
            display: flex;
            flex-direction: column;
        }
        .form-group.full {
            grid-column: 1 / -1;
        }
        .form-group label {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 5px;
        }
        .form-group label .required {
            color: #e53e3e;
        }
        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 12px 14px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 15px;
            font-family: inherit;
            transition: var(--transition);
            background: var(--bg);
            resize: vertical;
        }
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 4px rgba(123, 168, 196, 0.12);
            background: #fff;
        }
        .form-group textarea {
            min-height: 80px;
        }
        .form-group .hint {
            font-size: 12px;
            color: var(--text-light);
            margin-top: 4px;
        }

        /* ===== PERGUNTAS (Escuta Ativa) ===== */
        .perguntas-list {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }
        .pergunta-item {
            background: var(--bg);
            border-radius: var(--radius-sm);
            padding: 18px 20px;
            border-left: 4px solid var(--secondary);
        }
        .pergunta-item .q {
            font-weight: 600;
            font-size: 15px;
            color: var(--text);
            margin-bottom: 8px;
        }
        .pergunta-item .q .num-q {
            color: var(--secondary);
            margin-right: 6px;
        }
        .pergunta-item textarea {
            width: 100%;
            padding: 12px 14px;
            border: 2px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 15px;
            font-family: inherit;
            transition: var(--transition);
            background: #fff;
            min-height: 64px;
        }
        .pergunta-item textarea:focus {
            border-color: var(--secondary);
            outline: none;
            box-shadow: 0 0 0 4px rgba(212, 165, 165, 0.12);
        }

        /* ===== ESPECIALIDADES ===== */
        .especialidades-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .esp-item {
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--bg);
            border-radius: var(--radius-sm);
            padding: 12px 16px;
            cursor: pointer;
            transition: var(--transition);
            border: 2px solid transparent;
        }
        .esp-item:hover {
            border-color: var(--primary-light);
        }
        .esp-item.selected {
            border-color: var(--primary);
            background: rgba(123, 168, 196, 0.08);
        }
        .esp-item input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: var(--primary);
            cursor: pointer;
            flex-shrink: 0;
        }
        .esp-item .esp-info {
            flex: 1;
        }
        .esp-item .esp-info .esp-nome {
            font-weight: 600;
            font-size: 15px;
        }
        .esp-item .esp-info .esp-desc {
            font-size: 12px;
            color: var(--text-light);
        }
        .esp-item .freq-select {
            width: 100px;
            padding: 6px 8px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 13px;
            background: #fff;
            cursor: pointer;
            flex-shrink: 0;
        }
        .esp-item .freq-select:focus {
            border-color: var(--primary);
            outline: none;
        }

        /* ===== LOGÍSTICA ===== */
        .logistica-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .dias-horarios {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .dia-item {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--bg);
            border-radius: 8px;
            padding: 8px 14px;
        }
        .dia-item label {
            font-weight: 600;
            min-width: 60px;
            font-size: 14px;
        }
        .dia-item input[type="time"] {
            padding: 6px 10px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            background: #fff;
            flex: 1;
        }
        .dia-item input[type="time"]:focus {
            border-color: var(--primary);
            outline: none;
        }

        /* ===== PLANOS / RESUMO ===== */
        .plano-destaque {
            background: linear-gradient(135deg, var(--primary-light), rgba(123, 168, 196, 0.1));
            border-radius: var(--radius-sm);
            padding: 20px 24px;
            margin: 16px 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            border: 2px solid var(--primary);
        }
        .plano-destaque .plano-nome {
            font-size: 20px;
            font-weight: 700;
            color: var(--primary-dark);
        }
        .plano-destaque .plano-preco {
            font-size: 28px;
            font-weight: 800;
            color: var(--text);
        }
        .plano-destaque .plano-preco small {
            font-size: 16px;
            font-weight: 400;
            color: var(--text-light);
        }

        /* ===== NAV BTNS ===== */
        .nav-buttons {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            margin-top: 28px;
            flex-wrap: wrap;
        }
        .btn {
            padding: 12px 32px;
            border-radius: var(--radius-sm);
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none !important;
        }
        .btn-primary {
            background: var(--primary);
            color: #fff;
        }
        .btn-primary:hover:not(:disabled) {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(123, 168, 196, 0.3);
        }
        .btn-secondary {
            background: var(--bg);
            color: var(--text);
            border: 2px solid var(--border);
        }
        .btn-secondary:hover:not(:disabled) {
            background: var(--border);
        }
        .btn-success {
            background: var(--success);
            color: #fff;
        }
        .btn-success:hover:not(:disabled) {
            background: #38a169;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(72, 187, 120, 0.3);
        }
        .btn-pdf {
            background: #e53e3e;
            color: #fff;
        }
        .btn-pdf:hover:not(:disabled) {
            background: #c53030;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(229, 62, 62, 0.3);
        }

        /* ===== RESUMO FINAL ===== */
        #resumoFinal {
            background: var(--card);
            border-radius: var(--radius);
            padding: 32px 36px;
            box-shadow: var(--shadow);
            margin-bottom: 28px;
            display: none;
        }
        #resumoFinal.active {
            display: block;
            animation: fadeUp 0.4s ease;
        }
        #resumoFinal h3 {
            font-size: 22px;
            margin-bottom: 16px;
        }
        .resumo-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px 36px;
        }
        .resumo-grid .bloco {
            background: var(--bg);
            border-radius: var(--radius-sm);
            padding: 16px 20px;
        }
        .resumo-grid .bloco h4 {
            font-size: 16px;
            color: var(--primary);
            margin-bottom: 8px;
            border-bottom: 2px solid var(--primary-light);
            padding-bottom: 6px;
        }
        .resumo-grid .bloco p,
        .resumo-grid .bloco li {
            font-size: 14px;
            color: var(--text);
            line-height: 1.7;
        }
        .resumo-grid .bloco ul {
            list-style: none;
            padding: 0;
        }
        .resumo-grid .bloco ul li::before {
            content: '✓ ';
            color: var(--success);
            font-weight: 700;
        }

        /* ===== PDF PREVIEW (for generation) ===== */
        #pdfContent {
            background: #fff;
            padding: 40px 36px;
            border-radius: var(--radius-sm);
            font-family: 'Segoe UI', system-ui, sans-serif;
            max-width: 800px;
            margin: 0 auto;
            display: none;
        }
        #pdfContent .pdf-header {
            display: flex;
            align-items: center;
            gap: 20px;
            border-bottom: 3px solid var(--primary);
            padding-bottom: 20px;
            margin-bottom: 24px;
        }
        #pdfContent .pdf-header .pdf-logo {
            width: 64px;
            height: 64px;
            background: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }
        #pdfContent .pdf-header .pdf-info h2 {
            font-size: 22px;
            color: var(--text);
        }
        #pdfContent .pdf-header .pdf-info p {
            font-size: 13px;
            color: var(--text-light);
        }
        #pdfContent .pdf-section {
            margin-bottom: 20px;
        }
        #pdfContent .pdf-section h3 {
            font-size: 17px;
            color: var(--primary-dark);
            border-bottom: 2px solid var(--primary-light);
            padding-bottom: 4px;
            margin-bottom: 10px;
        }
        #pdfContent .pdf-section p,
        #pdfContent .pdf-section li {
            font-size: 14px;
            line-height: 1.7;
            color: var(--text);
        }
        #pdfContent .pdf-section ul {
            padding-left: 20px;
        }
        #pdfContent .pdf-table {
            width: 100%;
            border-collapse: collapse;
            margin: 12px 0;
        }
        #pdfContent .pdf-table th,
        #pdfContent .pdf-table td {
            padding: 10px 14px;
            border: 1px solid var(--border);
            text-align: left;
            font-size: 14px;
        }
        #pdfContent .pdf-table th {
            background: var(--primary);
            color: #fff;
            font-weight: 600;
        }
        #pdfContent .pdf-table td {
            background: #fff;
        }
        #pdfContent .pdf-table .total-row {
            background: var(--primary-light);
            font-weight: 700;
        }
        #pdfContent .pdf-beneficios {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 16px;
            margin: 8px 0;
        }
        #pdfContent .pdf-beneficios span {
            background: var(--bg);
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 13px;
            border: 1px solid var(--primary-light);
        }
        #pdfContent .pdf-politicas {
            background: #faf5f5;
            padding: 14px 18px;
            border-radius: 8px;
            border-left: 4px solid var(--secondary);
            font-size: 13px;
            line-height: 1.7;
        }
        #pdfContent .pdf-footer {
            text-align: center;
            border-top: 2px solid var(--border);
            padding-top: 16px;
            margin-top: 24px;
            font-size: 12px;
            color: var(--text-light);
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            #appContainer {
                padding: 12px 14px 40px;
            }
            .header {
                padding: 18px 20px;
                flex-direction: column;
                text-align: center;
            }
            .header-info h1 {
                font-size: 22px;
            }
            .header-contact {
                justify-content: center;
                font-size: 13px;
            }
            .header-badge {
                align-self: center;
            }
            .progress-container {
                padding: 14px 12px;
                overflow-x: auto;
            }
            .progress-steps .step .label {
                font-size: 10px;
                max-width: 60px;
            }
            .progress-steps .step .circle {
                width: 32px;
                height: 32px;
                font-size: 13px;
            }
            .section-card {
                padding: 20px 18px;
            }
            .section-card h3 {
                font-size: 18px;
            }
            .form-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .especialidades-grid {
                grid-template-columns: 1fr;
            }
            .logistica-grid {
                grid-template-columns: 1fr;
            }
            .resumo-grid {
                grid-template-columns: 1fr;
            }
            .nav-buttons {
                flex-direction: column;
            }
            .nav-buttons .btn {
                width: 100%;
                justify-content: center;
            }
            .plano-destaque {
                flex-direction: column;
                text-align: center;
            }
            .login-box {
                padding: 32px 24px 28px;
            }
            .perguntas-list {
                gap: 14px;
            }
            .pergunta-item {
                padding: 14px 16px;
            }
            .dia-item {
                flex-wrap: wrap;
            }
            .dia-item label {
                min-width: 50px;
            }
            #pdfContent {
                padding: 20px 16px;
            }
