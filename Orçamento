                    { id: 'diaSeg', label: 'Segunda' },
                    { id: 'diaTer', label: 'Terça' },
                    { id: 'diaQua', label: 'Quarta' },
                    { id: 'diaQui', label: 'Quinta' },
                    { id: 'diaSex', label: 'Sexta' },
                    { id: 'diaSab', label: 'Sábado' }
                ];
                diasMap.forEach(d => {
                    const el = document.getElementById(d.id);
                    if (el && el.value) {
                        dias.push({ dia: d.label, horario: el.value });
                    }
                });

                return {
                    crianca: { nome: criancaNome, idade: criancaIdade, diagnostico: criancaDiagnostico },
                    perguntas: perguntas,
                    especialidades: especialidades,
                    totalSessoes: totalSessoes,
                    plano: plano,
                    chave: chave,
                    logistica: { responsavel: quemTrazNome, parentesco: quemTrazParentesco, dias: dias },
                    dataEmissao: new Date()
                };
            }

            function renderResumo(data) {
                const d = data;
                const precoTotal = d.plano.preco;
                const desconto = precoTotal * 0.05;
                const precoComDesconto = precoTotal - desconto;

                let espHtml = '';
                if (d.especialidades.length === 0) {
                    espHtml = '<li>Nenhuma especialidade selecionada (padrão 1x/semana)</li>';
                } else {
                    d.especialidades.forEach(e => {
                        espHtml += '<li>' + e.nome + ' — ' + e.freq + 'x/semana</li>';
                    });
                }

                let diasHtml = '';
                if (d.logistica.dias.length === 0) {
                    diasHtml = '<li>Não informado</li>';
                } else {
                    d.logistica.dias.forEach(dia => {
                        diasHtml += '<li>' + dia.dia + ' às ' + dia.horario + '</li>';
                    });
                }

                // Build resumo text from perguntas
                const dorText = buildDorText(d.perguntas);

                resumoGrid.innerHTML = `
                    <div class="bloco">
                        <h4>👶 Criança</h4>
                        <p><strong>${d.crianca.nome}</strong> · ${d.crianca.idade}</p>
                        ${d.crianca.diagnostico ? '<p style="margin-top:4px;font-size:13px;color:var(--text-light);">' + d.crianca.diagnostico + '</p>' : ''}
                    </div>
                    <div class="bloco">
                        <h4>🎯 Plano Terapêutico</h4>
                        <p><strong>${d.plano.nome}</strong> · ${d.totalSessoes} sessões/semana</p>
                        <ul>${espHtml}</ul>
                    </div>
                    <div class="bloco">
                        <h4>💬 Escuta Ativa — Dor dos Pais</h4>
                        <p style="font-size:13px;line-height:1.7;">${dorText}</p>
                    </div>
                    <div class="bloco">
                        <h4>📅 Logística</h4>
                        <p><strong>Responsável:</strong> ${d.logistica.responsavel} (${d.logistica.parentesco})</p>
                        <ul>${diasHtml}</ul>
                    </div>
                    <div class="bloco" style="grid-column:1/-1;">
                        <h4>💰 Orçamento</h4>
                        <div style="display:flex;flex-wrap:wrap;gap:20px 40px;margin-top:8px;">
                            <div><strong>Plano:</strong> ${d.plano.nome}</div>
                            <div><strong>Valor mensal:</strong> R$ ${precoTotal.toFixed(2).replace('.',',')}</div>
                            <div><strong>Desconto 5% (antecipação):</strong> -R$ ${desconto.toFixed(2).replace('.',',')}</div>
                            <div style="font-size:20px;font-weight:700;color:var(--primary-dark);">💰 Com desconto: R$ ${precoComDesconto.toFixed(2).replace('.',',')}/mês</div>
                        </div>
                        <div style="margin-top:10px;font-size:13px;color:var(--text-light);">⏳ Validade: 7 dias a partir de ${d.dataEmissao.toLocaleDateString('pt-BR')}</div>
                    </div>
                `;
            }

            function buildDorText(perguntas) {
                const hasContent = perguntas.some(p => p.trim().length > 0);
                if (!hasContent) return 'Sem relato registrado.';
                let lines = [];
                const labels = [
                    'Dificuldades no dia a dia',
                    'Preocupações com o desenvolvimento',
                    'Rotina familiar',
                    'Desafios para apoiar o tratamento',
                    'Expectativas com o acompanhamento'
                ];
                perguntas.forEach((p, i) => {
                    if (p.trim()) {
                        lines.push('<strong>' + labels[i] + ':</strong> ' + p.trim());
                    }
                });
                return lines.join('<br>');
            }

            // ========== VOLTAR EDITAR ==========
            window.voltarEditar = function() {
                resumoFinal.classList.remove('active');
                goToStep(1);
            };

            // ========== GERAR PDF ==========
            window.gerarPDF = function() {
                const data = gatherData();
                const btn = document.getElementById('btnGerarPDF');
                const btnText = document.getElementById('pdfBtnText');
                const btnSpinner = document.getElementById('pdfBtnSpinner');
                btn.disabled = true;
                btnText.textContent = 'Gerando PDF...';
                btnSpinner.style.display = 'inline-block';

                // Build PDF content
                const pdfContent = document.getElementById('pdfContent');
                pdfContent.style.display = 'block';
                pdfContent.innerHTML = buildPDFHTML(data);

                // Generate PDF
                const opt = {
                    margin: [10, 12, 10, 12],
                    filename: 'Orcamento_Espaco_Sentir_' + data.crianca.nome.replace(/\s+/g, '_') + '.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: {
                        scale: 2,
                        useCORS: true,
                        letterRendering: true,
                        backgroundColor: '#ffffff'
                    },
                    jsPDF: {
                        unit: 'mm',
                        format: 'a4',
                        orientation: 'portrait'
                    },
                    pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
                };

                html2pdf().set(opt).from(pdfContent).save().then(function() {
                    btn.disabled = false;
                    btnText.textContent = '📄 Gerar PDF';
                    btnSpinner.style.display = 'none';
                    pdfContent.style.display = 'none';
                }).catch(function(err) {
                    console.error('PDF error:', err);
                    alert('Erro ao gerar PDF. Tente novamente.');
                    btn.disabled = false;
                    btnText.textContent = '📄 Gerar PDF';
                    btnSpinner.style.display = 'none';
                    pdfContent.style.display = 'none';
                });
            };

            function buildPDFHTML(data) {
                const d = data;
                const precoTotal = d.plano.preco;
                const desconto = precoTotal * 0.05;
                const precoComDesconto = precoTotal - desconto;
                const hoje = d.dataEmissao.toLocaleDateString('pt-BR');
                const valido = new Date(d.dataEmissao);
                valido.setDate(valido.getDate() + 7);
                const validoStr = valido.toLocaleDateString('pt-BR');

                let espTableRows = '';
                if (d.especialidades.length === 0) {
                    espTableRows = `<tr><td>Terapia base</td><td>1x/semana</td><td>R$ ${d.plano.preco.toFixed(2).replace('.',',')}</td></tr>`;
                } else {
                    d.especialidades.forEach(e => {
                        espTableRows += `<tr><td>${e.nome}</td><td>${e.freq}x/semana</td><td>—</td></tr>`;
                    });
                }

                let diasList = '';
                if (d.logistica.dias.length > 0) {
                    diasList = d.logistica.dias.map(dia => dia.dia + ' às ' + dia.horario).join(' · ');
                } else {
                    diasList = 'A combinar';
                }

                const dorText = buildDorTextParaPDF(d.perguntas);

                return `
                    <div class="pdf-header">
                        <div class="pdf-logo">ES</div>
                        <div class="pdf-info">
                            <h2>Espaço Sentir</h2>
                            <p>${CLINICA.endereco} · ${CLINICA.telefone} · ${CLINICA.email}</p>
                        </div>
                    </div>

                    <div class="pdf-section">
                        <h3>👶 Dados da Criança</h3>
                        <p><strong>${d.crianca.nome}</strong> · ${d.crianca.idade}</p>
                        ${d.crianca.diagnostico ? '<p style="margin-top:4px;"><em>Diagnóstico:</em> ' + d.crianca.diagnostico + '</p>' : ''}
                    </div>

                    <div class="pdf-section">
                        <h3>💬 Escuta Ativa — A Dor dos Pais</h3>
                        <p>${dorText}</p>
                        <p style="margin-top:8px;font-style:italic;color:var(--primary-dark);">
                            → A partir desse olhar, construímos um plano terapêutico personalizado para transformar desafios em conquistas.
                        </p>
                    </div>

                    <div class="pdf-section">
                        <h3>📋 Plano Terapêutico</h3>
                        <table class="pdf-table">
                            <thead>
                                <tr><th>Especialidade</th><th>Frequência</th><th>Valor</th></tr>
                            </thead>
                            <tbody>
                                ${espTableRows}
                                <tr class="total-row">
                                    <td><strong>Plano ${d.plano.nome}</strong></td>
                                    <td><strong>${d.totalSessoes} sessões/semana</strong></td>
                                    <td><strong>R$ ${precoTotal.toFixed(2).replace('.',',')}/mês</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="pdf-section">
                        <h3>💰 Tabela de Orçamento</h3>
                        <table class="pdf-table">
                            <thead>
                                <tr><th>Descrição</th><th>Valor</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Plano ${d.plano.nome} — ${d.totalSessoes}x/semana</td><td>R$ ${precoTotal.toFixed(2).replace('.',',')}</td></tr>
                                <tr><td>Desconto por antecipação (5%)</td><td>-R$ ${desconto.toFixed(2).replace('.',',')}</td></tr>
                                <tr class="total-row"><td><strong>Total com desconto</strong></td><td><strong>R$ ${precoComDesconto.toFixed(2).replace('.',',')}/mês</strong></td></tr>
                            </tbody>
                        </table>
                        <p style="font-size:13px;color:var(--text-light);margin-top:6px;">⏳ Validade: ${validoStr} · Emitido em: ${hoje}</p>
                    </div>

                    <div class="pdf-section">
                        <h3>🎁 Benefícios Inclusos</h3>
                        <div class="pdf-beneficios">
                            ${BENEFICIOS.map(b => '<span>✓ ' + b + '</span>').join('')}
                        </div>
                    </div>

                    <div class="pdf-section">
                        <h3>📜 Logística</h3>
                        <p><strong>Responsável:</strong> ${d.logistica.responsavel} (${d.logistica.parentesco})</p>
                        <p><strong>Dias/Horários:</strong> ${diasList}</p>
                    </div>

                    <div class="pdf-section">
                        <h3>📌 Políticas do Contrato</h3>
                        <div class="pdf-politicas">
                            <ol style="padding-left:20px;margin:0;">
                                ${POLITICAS.map(p => '<li>' + p + '</li>').join('')}
                            </ol>
                        </div>
                    </div>

                    <div class="pdf-section" style="text-align:center;border:2px dashed var(--primary);border-radius:12px;padding:20px;">
                        <p style="font-size:18px;font-weight:700;color:var(--primary-dark);">💙 Equipe Espaço Sentir</p>
                        <p style="font-size:14px;color:var(--text-light);">Cuidando do desenvolvimento com amor e respeito.</p>
                        <p style="font-size:13px;margin-top:6px;">${CLINICA.telefone} · ${CLINICA.email}</p>
                    </div>

                    <div class="pdf-footer">
                        <p>Espaço Sentir — ${CLINICA.endereco} · Documento gerado em ${hoje}</p>
                        <p style="font-size:11px;">© Todos os direitos reservados.</p>
                    </div>
                `;
            }

            function buildDorTextParaPDF(perguntas) {
                const hasContent = perguntas.some(p => p.trim().length > 0);
                if (!hasContent) return 'A família não registrou relato específico neste momento.';
                let lines = [];
                const labels = [
                    'Dificuldades no dia a dia',
                    'Preocupações com o desenvolvimento',
                    'Rotina familiar',
                    'Desafios para apoiar o tratamento',
                    'Expectativas com o acompanhamento'
                ];
                perguntas.forEach((p, i) => {
                    if (p.trim()) {
                        lines.push('<strong>' + labels[i] + ':</strong> ' + p.trim());
                    }
                });
                if (lines.length === 0) return 'A família não registrou relato específico neste momento.';
                return lines.join('<br>');
            }

            // ========== INIT ==========
            // Load default plan display
            calcularPlano();

            // Allow enter key to go through sections
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    const activeSection = document.querySelector('.section-card.active');
                    if (activeSection) {
                        const id = activeSection.id;
                        const num = parseInt(id.replace('section', ''));
                        if (num < totalSteps) {
                            // only if not in a textarea
                            const tag = e.target.tagName;
                            if (tag !== 'TEXTAREA' && tag !== 'INPUT' && tag !== 'SELECT') {
                                nextSection(num);
                            }
                        }
                    }
                }
            });

            // Focus on login
            senhaInput.focus();

        })();
    </script>

</body>
</html>
